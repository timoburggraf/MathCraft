# MathCraft — persönliche Einstellungen und Zugangsschlüssel.
#
#   cp .env.beispiel .env      und dann hier unten ausfüllen
#
# Diese Datei ist die Vorlage und gehört ins Repository. Die daraus kopierte
# .env steht in .gitignore und verlässt den eigenen Rechner nie. Wer lieber
# ohne Datei arbeitet, setzt dieselben Namen als Umgebungsvariablen — die
# gewinnen gegen die .env.
#
# Prüfen, was gesetzt ist (zeigt nie einen Wert an):
#   .venv/bin/python konfig.py


# ---------------------------------------------------------------- Claude
# Erzeugt den Lehrplan, die Aufgabenpakete (build/generate_units.py) und die
# Erklärungen für das Kind (tutor/erklaerer.py). Ohne diesen Schlüssel laufen
# die App, der Heim-Dienst und alle Tests trotzdem — nur nichts Neues
# entsteht mehr.
#   Schlüssel anlegen: https://console.anthropic.com/settings/keys
#   Kosten: ein Nachdenken des Tutors rund 13 Cent, ein voller Paketlauf
#           bis zu 10 EUR (build/generate_units.py deckelt sich selbst).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Gemini
# Erzeugt die Illustrationen (build/make_images.py) und die vorproduzierten
# Vorlesestimmen (build/tts_erzeugen.py). Beides liegt fertig im Repository;
# der Schlüssel wird also nur gebraucht, wenn etwas Neues dazukommen soll.
# Ohne die Audiodateien liest die App mit der Gerätestimme vor.
#   Schlüssel anlegen: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------ Heim-Dienst
# Adresse, unter der das Handy den Rechner im heimischen WLAN erreicht. Wird
# beim Bauen in die App eingebacken, damit sie Updates findet und den
# Lernstand abliefert. Leer lassen heißt: build/build.py trägt die aktuell
# erkannte Adresse dieses Rechners ein; in der App lässt sie sich unter
# Einstellungen jederzeit von Hand ändern.
#   Beispiel: MC_SERVER=192.168.1.20:8790
MC_SERVER=

# ------------------------------------------------------------ Android-Bau
# Wo JDK 17 und das Android-SDK liegen. Leer lassen, wenn sie an den üblichen
# Orten stehen (~/.local/android-tools/jdk-17*, ~/Android/Sdk) oder das JDK im
# System installiert ist — build/android.sh findet sie dann selbst.
MC_JAVA_HOME=
MC_ANDROID_HOME=

# --------------------------------------------------------- Android-Signatur
# Nur nötig, um eine Release-APK zu bauen (build/android.sh). Ein Debug-Bau
# (build/android.sh debug) und die reine Web-App brauchen beides nicht.
# Anlegen des Schlüsselspeichers: siehe README.md, Abschnitt „Android".
MC_KEYSTORE=
MC_KEYSTORE_PW=
